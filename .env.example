# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Flask app (Task 4.4) ---
MODEL_PATH=models/champion/model.keras
# Leave empty to use threshold.json saved next to the model (chosen on validation data)
THRESHOLD=
MODEL_NAME=visionguard
MODEL_VERSION=local
MAX_UPLOAD_MB=5
HOST=127.0.0.1
PORT=5000

# Local default is SQLite. In Docker Compose this points at the Postgres service.
DATABASE_URL=sqlite:///instance/visionguard.db
# DATABASE_URL=postgresql+psycopg2://visionguard:${POSTGRES_PASSWORD}@db:5432/visionguard
