# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- DagsHub / MLflow tracking (Task 3.2) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Docker Compose database (Task 6.3) ---
POSTGRES_USER=visionguard
POSTGRES_DB=visionguard
POSTGRES_PASSWORD=<choose-a-strong-password>

# --- Flask app when run locally without Docker (Task 4.4) ---
MODEL_PATH=models/champion/model.keras
# Leave empty to use threshold.json saved next to the model (chosen on validation data)
THRESHOLD=
MODEL_NAME=visionguard
# Leave empty to use model_info.json written by load_champion.py --export
MODEL_VERSION=
MAX_UPLOAD_MB=5
HOST=127.0.0.1
PORT=5000
# Local default is SQLite; inside Compose, DATABASE_URL is set in docker-compose.yml
DATABASE_URL=sqlite:///instance/visionguard.db
